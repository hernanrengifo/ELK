# ekl-demo — variables de entorno (plan_demo.md §4.1)
#
# Copia este archivo a `.env` y ajusta lo que necesites:
#     cp .env.example .env
#
# Las variables están agrupadas por la fase que las introduce. Las de
# fases que todavía no se construyeron están comentadas.

# --- F0/F1: grafo -----------------------------------------------------
# memory = networkx en proceso (sin Docker, es el valor por defecto)
# neo4j  = Neo4j 5 Enterprise real (docker compose up -d neo4j)
GRAPH_BACKEND=memory

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=eklpassword
NEO4J_DB_NEGOCIO=negocio
NEO4J_DB_INFRA=infra
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- F2: servidores MCP ----------------------------------------------
# Rol del usuario cuando el cliente MCP no manda `user_ctx` en los
# metadatos de la llamada (por ejemplo, MCP Inspector). Si no se define,
# se usa `rol_por_defecto` de data/policies.yaml.
DEMO_USER_ROLE=riesgo

# Base que sirve la instancia de ekl-graph (negocio | infra). También se
# puede pasar por CLI: --base infra
EKL_GRAPH_BASE=negocio

# Transporte por defecto de los servidores MCP (stdio | http | sse)
EKL_MCP_TRANSPORT=stdio
EKL_MCP_HOST=127.0.0.1
EKL_ACTIONS_PORT=8010
EKL_GRAPH_PORT=8011

# Rutas de la auditoría y la traza (por defecto, la raíz del repo)
# EKL_AUDIT_FILE=audit.jsonl
# EKL_TRACE_FILE=trace.jsonl
# EKL_TRACE_DIR=observability/traces

# --- F2b: bus de eventos y Sala de control ---------------------------
# memory = cola in-process (sin Docker, valor por defecto)
# redis  = Redis Streams (docker compose up -d redis)
EVENT_BUS=memory
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
TRACE_STORE_PORT=8020
TRACE_STORE_HOST=0.0.0.0

# Quién escribe trace.jsonl. Por defecto, el propio proceso emisor con
# EVENT_BUS=memory y el servicio trace_store con EVENT_BUS=redis.
# EKL_TRACE_LOCAL=1

# --- F3/F4: agentes A y B --------------------------------------------
# Modelo del LLM. `fake` usa el simulado de agents/llm_fake.py: no
# necesita API key ni red, y es lo que usan los tests y el plan B.
LLM_MODEL=fake
# ANTHROPIC_API_KEY=sk-ant-...        # solo si LLM_MODEL es un modelo real

# Parámetros del modelo. `temperature` NO se manda por defecto: los
# modelos nuevos (claude-sonnet-5 y siguientes) devuelven
# `400 temperature is deprecated for this model` y tumban la corrida.
# Fíjalo solo si usas un modelo antiguo donde te sirva.
# EKL_LLM_TEMPERATURE=0
# EKL_LLM_MAX_TOKENS=2048

AGENT_A_PORT=8001
AGENT_B_PORT=8002
AGENT_HOST=0.0.0.0
AGENT_B_URL=http://127.0.0.1:8002

# Dónde están los servidores MCP. Sin estas variables, los agentes los
# instancian en su propio proceso (más rápido; es lo que usan los tests).
# Con ellas, hablan por HTTP con servidores ya levantados.
# EKL_MCP_GRAPH_URL=http://127.0.0.1:8011/mcp
# EKL_MCP_ACTIONS_URL=http://127.0.0.1:8010/mcp

# --- F5 / F5b: UI y Sala de control ----------------------------------
# La UI se arranca con `streamlit run ui/app.py --server.port 8501`.
# Estas variables solo hacen falta si algo no está donde se espera.
# AGENT_A_URL=http://127.0.0.1:8001
# TRACE_STORE_URL=http://localhost:8020
# Segundos que la UI espera una respuesta del Agente A (con modelo real
# conviene subirlo).
# UI_TIMEOUT=300
